[Unit]
Description=ansible-pull: reconciliar o bootstrap do cluster ldsa a partir do repositório infrastructure
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment="GIT_SSH_COMMAND=ssh -i /root/.ssh/infrastructure-deploy-key -o IdentitiesOnly=yes"
ExecStart=/usr/local/bin/ansible-pull \
  -U git@github.com:ladesa-ro/infrastructure.git \
  -C main \
  --vault-password-file /root/infrastructure-vault-pass \
  --skip-tags firewalld \
  ansible/local.yml
